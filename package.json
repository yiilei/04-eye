{
  "name": "caiguang",
  "version": "0.3.13",
  "private": false,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "desktop:dev": "pnpm run build && electron .",
    "desktop:live": "node scripts/desktop-live.mjs",
    "desktop:live:app": "node scripts/package-live-macos-app.mjs",
    "desktop:package": "pnpm run build && node scripts/package-macos-app.mjs",
    "desktop:package:public": "VITE_PUBLIC_DISTRIBUTION=1 pnpm run build && node scripts/package-macos-app.mjs",
    "setup:downloader": "zsh scripts/setup-downloader.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "vendor/XHS-Downloader/.venv/bin/python -m unittest tests/test_xhs_capture.py tests/test_xhs_browser_media_import.py && vendor/xhs-cli/.venv/bin/python -m unittest tests/test_h5_capture.py tests/test_xhs_session_isolation.py && pnpm run validate:review && pnpm run build && node --test tests/rendered-html.test.mjs tests/xhs-discover.test.mjs tests/xhs-events-discover.test.mjs tests/data-migration.test.mjs tests/starter-data.test.mjs tests/onboarding-desktop.test.mjs tests/scheduler-policy.test.mjs tests/h5-pipeline-policy.test.mjs tests/note-capture-policy.test.mjs tests/mcp-server.test.mjs",
    "validate:review": "node scripts/validate-review-manifest.mjs",
    "capture:xhs": "vendor/XHS-Downloader/.venv/bin/python scripts/xhs-capture.py",
    "import:xhs-browser": "vendor/XHS-Downloader/.venv/bin/python scripts/xhs-browser-media-import.py",
    "discover:xhs": "node scripts/xhs-discover.mjs",
    "verify:xhs-pins": "node scripts/xhs-verify-pins.mjs",
    "discover:xhs-events": "node scripts/xhs-events-discover.mjs",
    "discover:xhs:check": "node scripts/xhs-discover.mjs --account 63044481856",
    "backlog:xhs": "node scripts/xhs-backlog.mjs",
    "xhs:login": "node scripts/xhs-session.mjs login",
    "xhs:status": "node scripts/xhs-session.mjs status",
    "xhs:logout": "node scripts/xhs-session.mjs logout",
    "capture:h5": "node scripts/capture-h5-event.mjs",
    "register:h5": "node scripts/register-h5-event.mjs",
    "daily:run": "node scripts/daily-pipeline.mjs",
    "daily:auto": "node scripts/daily-auto.mjs",
    "daily:check": "node scripts/daily-pipeline.mjs --dry-run",
    "check": "pnpm run validate:review && pnpm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.4.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
